# =========================================================
# 斐讯 K2 核心硬件与芯片架构配置 (MT7620A)
# =========================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y

# =========================================================
# 极致精简 LuCI：仅保留最原始的网页框架与中文语言
# =========================================================
CONFIG_MODULES=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_LUCI_LANG_zh_Hans=y

# ❌ 强制禁用所有第三方臃肿主题，只用原版 Bootstrap 节省空间
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set

# =========================================================
# 必备网络组件与 完整 IPv6 支持
# =========================================================
CONFIG_IPV6=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ip6tables=y

# =========================================================
# 核心服务：Lucky 服务组件 (只装核心，不装 LuCI 快捷菜单)
# =========================================================
# 提示：不勾选 luci-app-lucky 可以省下几百 KB。Lucky 自带非常完美的
# 独立 Web 面板，通过 K2_IP:16601 访问。我们在 OpenWrt 里只需要保证它运行。
CONFIG_PACKAGE_lucky=y

# =========================================================
# 强制瘦身：剔除一切 K2 不需要的文件与额外无线驱动
# =========================================================
# CONFIG_PACKAGE_etherwake is not set
# CONFIG_PACKAGE_wpa-supplicant is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
