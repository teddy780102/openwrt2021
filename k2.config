# =========================================================
# 斐讯 K2 核心硬件与芯片架构配置 (MT7620A)
# =========================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y

# =========================================================
# 基础 LuCI 网页界面：只保留最原始的网页框架与中文
# =========================================================
CONFIG_MODULES=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# 无线中继组件：支持给本地 WiFi 加密以及进行无线桥接扫描
# =========================================================
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# =========================================================
# 宽带拨号组件：完美支持传统 PPPoE 拨号
# =========================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# =========================================================
# ❌ 彻底关闭 IPv6（这一步省下巨大空间，根治体积超标问题）
# =========================================================
# CONFIG_IPV6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ip6tables is not set

# =========================================================
# 极致瘦身：坚决不引入臃肿的第三方包
# =========================================================
# CONFIG_PACKAGE_lucky is not set
